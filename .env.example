# Frontend (Vite — VITE_ prefix required)
VITE_FIREBASE_STORAGE_BASE_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Backend (Netlify Functions — server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_GEN=claude-sonnet-4-6
ANTHROPIC_MODEL_SAFETY=claude-haiku-4-5
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
RATE_LIMIT_PER_HOUR=25
IP_SALT_BASE=
# Comma-separated list of allowed browser Origins for /generate (CSRF shield).
# Leave blank in dev (no-op). In prod set to e.g. https://blessyourheart.app
# Server-to-server clients without Origin header are unaffected.
ALLOWED_ORIGINS=
# Set to 'false' to skip the Haiku tone classifier (local dev / cost control).
# Any other value (or unset) leaves the tone check enabled.
ENABLE_TONE_CHECK=

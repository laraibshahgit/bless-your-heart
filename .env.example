# Bless Your Heart — Environment Variables
#
# Copy this file to `.env.local` (gitignored) for local dev. In production,
# set these values in the Netlify dashboard (Site settings → Environment).
#
# Required-in-production variables are marked [REQ-PROD]. When CONTEXT=production
# at lambda cold-start, `validateProdEnv()` in src/server/configValidation.ts
# emits a `config_validation_failed` log line listing any [REQ-PROD] vars that
# are missing or empty. Full reference: docs/CONFIGURATION.md.
#
# ─────────────────────────────────────────────────────────────────────────
# Frontend (Vite — VITE_ prefix REQUIRED to expose to the browser bundle)
# ─────────────────────────────────────────────────────────────────────────

# [REQ-PROD] Public photo CDN base URL. Without this getPhotoUrl() returns
# a relative path and every poster fails to render.
# Example: https://firebasestorage.googleapis.com/v0/b/<project>.firebasestorage.app/o
VITE_FIREBASE_STORAGE_BASE_URL=

# Optional. PostHog project key (public — safe to ship in the client bundle).
# Empty/unset = analytics disabled (no SDK is loaded; see src/lib/analytics.ts).
VITE_POSTHOG_KEY=

# Optional. PostHog ingest host (public — safe to ship in the client bundle).
# Required only if VITE_POSTHOG_KEY is set.
VITE_POSTHOG_HOST=

# ─────────────────────────────────────────────────────────────────────────
# Backend (Netlify Functions — server-only, NEVER prefix with VITE_)
# ─────────────────────────────────────────────────────────────────────────

# [REQ-PROD] Anthropic API key. Without this every Anthropic call returns
# 401 and the user always sees a safe_fallback poster. Use a key with
# rate-limit headroom for traffic + retries.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 / claude-haiku-4-5 in code.
ANTHROPIC_MODEL_GEN=claude-sonnet-4-6
ANTHROPIC_MODEL_SAFETY=claude-haiku-4-5

# [REQ-PROD] Firebase service-account credentials. Used by src/server/firebaseAdmin.ts
# to back the rate-limit Firestore collection. FIREBASE_PRIVATE_KEY is a multi-line
# PEM — escape newlines as `\n` in the env value.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Optional. Per-IP-per-hour rate limit (default 25 if unset/misconfigured).
# Set to 9999 for local dev to bypass the limiter entirely. Misconfigs (NaN,
# negative, zero, empty) fall back to 25 via parseRateLimit() — see
# src/server/rateLimit.ts. Behavior pinned by rateLimit-extended.test.ts.
RATE_LIMIT_PER_HOUR=25

# [REQ-PROD] HMAC pepper for the daily-rotated IP hash in src/server/rateLimit.ts.
# Generate once during deploy setup (e.g. `openssl rand -hex 32`); never rotate
# (the daily-date suffix handles rotation). When unset in production the code
# falls back to the literal string `'byh-default-salt'` — daily date still
# rotates the salt but it's no longer per-deploy. validateProdEnv() flags
# this loud at cold-start so ops can backfill the value before a security
# review notices.
IP_SALT_BASE=

# [REQ-PROD] Comma-separated list of allowed browser Origins for the
# /generate endpoint (CSRF / cross-origin cost-amplification shield in
# netlify/functions/generate.ts). When unset, isOriginAllowed() is a no-op
# — the production deploy serves /generate to ANY origin, which lets a
# malicious site spend your Anthropic budget by embedding the call.
# Example: https://blessyourheart.app,https://www.blessyourheart.app
# Server-to-server clients without an Origin header are unaffected.
ALLOWED_ORIGINS=

# Optional. Set to 'false' to skip the Haiku tone classifier (local dev /
# cost control). Any other value (or unset) keeps the tone check enabled.
# Routes through to checkTone() in src/server/anthropic.ts.
ENABLE_TONE_CHECK=
